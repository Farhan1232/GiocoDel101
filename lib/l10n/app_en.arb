  "tutorial101": "Exactly 101",
  "tutorial101Body": "Landing on exactly 101 resets your score to zero. It is the twist that can turn a whole match around.",
  "tutorialAce": "Ace — skip the turn",
  "tutorialAceBody": "The Ace makes the next player lose their turn. With two players, the turn comes straight back to you.",
  "tutorialCavallo": "Knight — change suit",
  "tutorialCavalloBody": "The Knight (9) can be played at any moment and lets you choose the new active suit with the Suit Ritual.",
  "tutorialDraw": "Drawing",
  "tutorialDrawBody": "With no playable card you draw from the deck. If the drawn card is legal you may play it at once, otherwise the turn passes.",
  "tutorialGoal": "Goal",
  "tutorialGoalBody": "Empty your hand before the others. The cards left in your opponents' hands become penalty points: go over 101 and you are out, land on exactly 101 and you go back to zero.",
  "tutorialMatch": "Suit or value",
  "tutorialMatchBody": "You may play a card of the active suit, or one of the same value as the card on top of the discard pile.",
  "tutorialOver101": "Past 101",
  "tutorialOver101Body": "Going over 101 means leaving the match. Whoever manages the high cards best stays in.",
  "tutorialScoring": "Scoring",
  "tutorialScoringBody": "At the end of a round every card left is worth its number: Ace 1, Jack 8, Knight 9, King 10. The points add to your total.",
  "tutorialTwo": "Two — draw two",
  "tutorialTwoBody": "The 2 forces the next player to draw two cards. Holding another 2 they can raise: +4, +6, +8. Whoever stops draws the lot and loses the turn.",
  "tutorialWin": "Winning the match",
  "tutorialWinBody": "The match ends when a single player is left standing. That player wins the Gioco del 101.",
